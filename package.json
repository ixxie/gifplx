		"vitest": "^4.0.18",
		"vitest-browser-svelte": "^2.0.2"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.10.1",
		"gif.js": "^0.2.0",
		"gifuct-js": "^2.1.2"
